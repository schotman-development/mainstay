{
    "name": "mainstay/cms",
    "description": "A headless CMS for Laravel: content modelled in PHP, edited in a React admin, served to static sites over HTTP.",
    "keywords": ["laravel", "cms", "headless", "content"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mainstay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mainstay\\MainstayServiceProvider"
            ],
            "aliases": {
                "Mainstay": "Mainstay\\Facades\\Mainstay"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
