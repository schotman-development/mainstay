{
    "name": "mainstay/cms",
    "description": "A headless CMS for Laravel: content modelled in PHP, edited in a Blade admin, served to static sites over HTTP.",
    "keywords": ["laravel", "cms", "headless", "content"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "mainstay/ui": "@dev",
        "spatie/image": "^3.9"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ui"
        }
    ],
    "autoload": {
        "psr-4": {
            "Mainstay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mainstay\\MainstayServiceProvider"
            ],
            "aliases": {
                "Mainstay": "Mainstay\\Facades\\Mainstay"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
